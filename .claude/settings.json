{
  "permissions": {
    "allow": ["Bash(*)", "WebSearch", "mcp__playwright"],
    "deny": ["Read(.env)", "Read(.env.*)"]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [".env", ".env.*"]
    }
  },
  "agentPushNotifEnabled": true
}
