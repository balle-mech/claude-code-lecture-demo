{
  "permissions": {
    "allow": ["Bash(*)", "WebSearch", "mcp__playwright"],
    "deny": ["Read(.env)", "Read(.env.*)"]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [".env", ".env.*"]
    }
  },
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --ff-only 2>&1 | jq -Rs '{systemMessage: (\"git pull: \" + rtrimstr(\"\\n\"))}'",
            "timeout": 30,
            "statusMessage": "git pull 実行中..."
          }
        ]
      }
    ]
  }
}
